flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        User([Developer or CI]):::edge
        CLI["msscan CLI<br/>scan, rules, serve"]:::edge
        Py["Python package<br/>PyO3 bindings"]:::edge
        Service["HTTP service<br/>POST /v1/scan"]:::core
        User --> CLI ~~~ Py ~~~ Service
    end

    subgraph Input["Input handling"]
        direction TB
        Files[("Model files<br/>memory-mapped")]:::data
        Sniff["Format detection<br/>magic bytes"]:::control
        Zip["Zip reader<br/>cross-checks"]:::core
        Decomp["Decompression<br/>size-limited"]:::control
        Files --> Sniff --> Zip ~~~ Decomp
    end

    subgraph Analyzers["Analyzers"]
        direction TB
        VM["Pickle VM<br/>symbolic opcodes"]:::core
        Policy["Global tiers<br/>allow, deny"]:::control
        Graphs["Graph checks<br/>Keras, TF, ONNX"]:::core
        Headers["Header checks<br/>GGUF, safetensors"]:::core
        Jinja["Chat templates<br/>injection"]:::core
        Limits["Limits<br/>opcodes, sizes"]:::control
        Limits ~~~ VM --> Policy ~~~ Graphs ~~~ Headers --> Jinja
    end

    subgraph Out["Outputs, evaluation"]
        direction TB
        Reports["Reports<br/>text, JSON, SARIF"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Bench["Inert corpus<br/>validated"]:::obs
        Hub["Hub corpus<br/>headers, stubs"]:::obs
        Score["Verdict<br/>noisy-or risk"]:::control
        Score --> Reports ~~~ Metrics ~~~ Bench ~~~ Hub
    end

    Interfaces -->|files| Input
    Input -->|members| Analyzers
    Analyzers -->|findings| Out
